# Copie este arquivo para .env.local e configure suas variáveis

# Database - MongoDB Atlas
MONGODB_URI="mongodb://localhost:27017/sexyflow"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="sexyflow-local-development-secret-key-2025"

# Email (para notificações)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Upload de arquivos
UPLOAD_MAX_SIZE="2147483648" # 2GB em bytes
UPLOAD_PATH="./public/uploads"

# Subdomínios
BASE_DOMAIN="sexyflow.com"

# Cakto (para pagamentos)
CAKTO_API_KEY="your-cakto-api-key"
CAKTO_WEBHOOK_SECRET="your-cakto-webhook-secret"

